{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local window events, native pickers and dragging only. No shell or filesystem plugin access.",
  "windows": ["workspace", "quick"],
  "permissions": ["core:event:default", "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize", "dialog:allow-open"]
}
