{
  "name": "fluxdl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first yt-dlp desktop client with a quiet Midnight Glass interface",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "release:stage": "node scripts/stage-release.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
