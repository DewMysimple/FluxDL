{
  "name": "fluxdl",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "A local-first yt-dlp desktop client with a quiet Midnight Glass interface",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts scripts eslint.config.mjs --max-warnings 0",
    "format:check": "prettier --check src vite.config.ts eslint.config.mjs package.json scripts/release/*.mjs scripts/{stage-release,build-desktop,release,test-release,diagnostics-smoke}.mjs",
    "format": "prettier --write src vite.config.ts eslint.config.mjs package.json scripts/release/*.mjs scripts/{stage-release,build-desktop,release,test-release,diagnostics-smoke}.mjs",
    "benchmark:frontend": "node scripts/benchmark-frontend.mjs",
    "benchmark:rust": "cargo run --manifest-path src-tauri/Cargo.toml --release --example engineering_bench --",
    "test:styles": "node scripts/check-style-equivalence.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "release:build": "node scripts/release.mjs build",
    "release:stage": "node scripts/stage-release.mjs",
    "release:verify": "node scripts/release.mjs verify",
    "release:clean": "node scripts/release.mjs clean",
    "test:release": "node --test scripts/test-release.mjs",
    "test:diagnostics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-diagnostics.ps1",
    "benchmark:diagnostics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-diagnostics.ps1 -Samples 20 -BenchmarkOnly",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
